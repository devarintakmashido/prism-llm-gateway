<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.prism</groupId>
    <artifactId>prism-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Prism</name>
    <description>Prism - LLM gateway with difficulty-based routing and a semantic cache</description>

    <modules>
        <module>prism-common</module>
        <module>prism-gateway</module>
        <module>prism-control-plane</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <langchain4j-embeddings.version>1.20.2-beta30</langchain4j-embeddings.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.prism</groupId>
                <artifactId>prism-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
                <version>${langchain4j-embeddings.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
