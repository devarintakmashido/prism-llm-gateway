# Copy to .env (git-ignored) to override defaults; docker compose reads it automatically.
#
#   cp .env.example .env
#
# The admin token protects the control plane's /admin/* APIs and the ops console.
# The default is fine for a local demo; change it for anything reachable from a network.
PRISM_ADMIN_TOKEN=prism-admin-dev-token

# Optional: a real hosted provider (OpenRouter) as the LAST fallback after the two mocks.
# Leave empty and Prism runs on the mocks alone, exactly as in the graded flow. With a key, the
# `fast` chain ends in openai/gpt-4.1-nano and `smart` in openai/gpt-4.1-mini (data/gateway_extras.json).
# Airtribe's perk page names these OPENAI_API_KEY and OPENAI_BASE_URL; either spelling works.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
